{
  "version": 1,
  "size": 2048,
  "seed": 412,
  "tile": true,
  "imports": {"structure": "../rooted-tree/bark.texutil.json"},
  "nodes": {
    "height": {"op": "transform", "input": "structure.height", "scale": [1, 0.25], "edge": "repeat"},
    "pigment": {"op": "transform", "input": "structure.pigment", "scale": [1, 0.25], "edge": "repeat"},
    "pigment-color": {"op": "ramp", "input": "pigment", "stops": [[0, "#30251f"], [0.3, "#513b2e"], [0.65, "#79563d"], [1, "#9b8060"]]},
    "crack-color": {"op": "ramp", "input": "height", "stops": [[0, "#554b40"], [0.18, "#8b7967"], [0.5, "#e2d3bb"], [0.75, "#ffffff"], [1, "#ffffff"]]},
    "color": {"op": "blend", "a": "pigment-color", "b": "crack-color", "mode": "multiply"},
    "normal": {"op": "normal", "input": "height", "strength": 0.008, "convention": "opengl", "edge": "repeat"},
    "roughness": {"op": "levels", "input": "height", "out": [0.95, 0.8]},
    "zero": {"op": "constant", "value": 0},
    "metallic-roughness": {"op": "pack", "r": "zero", "g": "roughness", "b": "zero"},
    "repeat-height": {"op": "transform", "input": "height", "scale": [0.5, 0.5], "edge": "repeat"}
  },
  "outputs": {
    "bark-height.png": {"node": "height", "bits": 16},
    "bark-color.png": "color",
    "bark-normal.png": "normal",
    "bark-roughness.png": "roughness",
    "bark-metallic-roughness.png": "metallic-roughness",
    "bark-sheet.png": {
      "type": "sheet", "title": "Pine bark | Short fissured plates", "columns": 3, "cell": 384,
      "items": [
        {"node": "height", "label": "Height / 16-bit master"},
        {"node": "normal", "label": "Normal / OpenGL"},
        {"node": "color", "label": "Unlit base color"},
        {"node": "roughness", "label": "Dry roughness"},
        {"node": "repeat-height", "label": "2x2 height repeat"}
      ]
    },
    "bark.mtlx": {
      "type": "materialx", "name": "PineBark",
      "inputs": {"base_color": {"texture": "bark-color.png"}, "specular_roughness": {"texture": "bark-roughness.png"}, "metalness": 0, "specular_IOR": 1.5},
      "normal": {"texture": "bark-normal.png", "convention": "opengl"}
    }
  }
}
