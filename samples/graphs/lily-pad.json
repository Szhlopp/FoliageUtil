{
  "version": 1,
  "seed": 42,
  "units": "meters",
  "name": "Lily pads",
  "description": "Gently cupped, notched pad cards with six TexUtil surface variants and submerged petioles.",
  "materials": {
    "pad": {
      "base_color": [
        0.58,
        0.78,
        0.58,
        1
      ],
      "base_color_texture": "../assets/lily-pad/pads.atlas.assets/color.png",
      "normal_texture": "../assets/lily-pad/pads.atlas.assets/normal.png",
      "metallic_roughness_texture": "../assets/lily-pad/pads.atlas.assets/metallic-roughness.png",
      "roughness": 1,
      "double_sided": true,
      "translucency": 0.08,
      "alpha_mode": "MASK",
      "alpha_cutoff": 0.5
    },
    "petiole": {
      "base_color": [
        0.14,
        0.19,
        0.065,
        1
      ],
      "roughness": 0.5
    }
  },
  "nodes": {
    "pad_card": {
      "op": "card",
      "width": 0.4,
      "height": 0.4,
      "pivot": "center",
      "segments": 32,
      "width_segments": 32,
      "curl": 0.045,
      "fold": 0.023,
      "twist": 1.2,
      "material": "pad"
    },
    "display_site": {
      "op": "radial",
      "count": 1,
      "radius": [
        0,
        0
      ],
      "tilt": [
        0,
        0
      ],
      "height": [
        0,
        0
      ],
      "jitter": 0
    },
    "single_surface": {
      "op": "instance",
      "input": "pad_card",
      "points": "display_site",
      "atlas": "../assets/lily-pad/pads.atlas.json",
      "atlas_mode": "fixed",
      "color_variation": 0,
      "rotation": [
        -90,
        0,
        0
      ]
    },
    "pad_surface": {
      "op": "transform",
      "input": "single_surface",
      "rotation": [
        0,
        0,
        0
      ]
    },
    "petiole_path": {
      "op": "curve",
      "points": [
        [
          0.025,
          -0.36,
          0.02
        ],
        [
          0.011,
          -0.27,
          0.012
        ],
        [
          -0.004,
          -0.16,
          0.004
        ],
        [
          0,
          -0.055,
          0
        ],
        [
          0,
          0,
          0
        ]
      ],
      "radius": 0.0035,
      "taper": 0.28
    },
    "petiole": {
      "op": "tube",
      "input": "petiole_path",
      "sides": 8,
      "material": "petiole",
      "cap_material": "petiole"
    },
    "single_plant": {
      "op": "merge",
      "inputs": [
        "pad_surface",
        "petiole"
      ]
    },
    "pad_sites": {
      "op": "orient",
      "input": "all_sites",
      "mode": "keep",
      "rotation_jitter": [
        0,
        180,
        0
      ]
    },
    "upright_cards": {
      "op": "instance",
      "input": "pad_card",
      "points": "pad_sites",
      "rotation": [
        -90,
        0,
        0
      ],
      "atlas": "../assets/lily-pad/pads.atlas.json",
      "scale_jitter": [
        0.12,
        0.05,
        0.1
      ],
      "color_variation": 0.12
    },
    "petioles": {
      "op": "instance",
      "input": "petiole",
      "points": "pad_sites",
      "color_variation": 0.1
    },
    "patch": {
      "op": "merge",
      "inputs": [
        "upright_cards",
        "petioles"
      ]
    },
    "outer_sites": {
      "op": "radial",
      "count": 6,
      "mode": "ring",
      "radius": [
        0.47,
        0.52
      ],
      "angle": 15,
      "height": [
        0.001,
        0.004
      ],
      "tilt": [
        0,
        0
      ],
      "scale": [
        0.78,
        1.02
      ],
      "jitter": 0.06
    },
    "center_site": {
      "op": "radial",
      "count": 1,
      "radius": [
        0.015,
        0.015
      ],
      "angle": 0,
      "height": [
        0,
        0
      ],
      "tilt": [
        0,
        0
      ],
      "scale": [
        1.05,
        1.05
      ],
      "jitter": 0.04
    },
    "all_sites": {
      "op": "merge",
      "inputs": [
        "center_site",
        "outer_sites"
      ]
    }
  },
  "outputs": {
    "lily-pad.glb": "patch",
    "lily-pad.obj": "patch",
    "lily-pad-single.glb": "single_plant",
    "lily-pad-surface.glb": "pad_surface",
    "lily-pad-surfaces.glb": "upright_cards"
  }
}
